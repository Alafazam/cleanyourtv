<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass pill behind the prayer line on Home: a light dark base so it reads over bright photos, a white
     frost on top and a fine light edge, like the top buttons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
