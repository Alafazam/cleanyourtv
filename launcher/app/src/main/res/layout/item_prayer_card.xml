<?xml version="1.0" encoding="utf-8"?>
<!-- One prayer in the prayer view: icon, Arabic name, English name, time. PrayerUi fills it in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="128dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:background="@drawable/prayer_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/prayerIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/prayerArabic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/prayerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/outfit_regular" />

    <TextView
        android:id="@+id/prayerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:fontFamily="@font/outfit_light" />
</LinearLayout>
